<div id="<%= dom_id challenge %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Title:</strong>
    <%= challenge.title %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Description:</strong>
    <%= challenge.description %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Journey:</strong>
    <%= link_to challenge.journey.title, journey_path(challenge.journey), class: "text-blue-600 hover:text-blue-800" %>
  </p>
</div>
