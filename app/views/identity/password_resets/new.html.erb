<% if alert == Identity::PasswordResetsController::UNVERIFIED_EMAIL_ALERT %>
  <% content_for :suppress_flash %>
  <div class="rounded-md bg-yellow-50 p-4">
    <h3 class="text-sm font-medium text-yellow-800">Your email isn't verified yet</h3>
    <div class="mt-2 text-sm text-yellow-700">
      <p><%= alert %>. Check your inbox for the verification email we sent when you signed up, or resend it below and try again.</p>
    </div>
    <div class="mt-4">
      <%= button_to "Resend verification email", identity_email_verification_path(email: params[:email]), class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    </div>
  </div>
<% end %>

<h1>Forgot your password?</h1>

<%= form_with(url: identity_password_reset_path) do |form| %>
  <div>
    <%= form.label :email, style: "display: block" %>
    <%= form.email_field :email, required: true, autofocus: true %>
  </div>

  <div>
    <%= form.submit "Send password reset email" %>
  </div>
<% end %>
