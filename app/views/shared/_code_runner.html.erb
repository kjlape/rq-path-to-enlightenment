<div class="my-5">
  <strong class="block font-medium mb-1">Initial code:</strong>
  <pre>
    <code-input language="ruby" data-minitest-target="code"><%= initial_code %></code-input>
  </pre>
  <button data-action="click->minitest#run" data-minitest-target="runButton" class="cursor-pointer mt-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium disabled:opacity-50 disabled:cursor-not-allowed">Run</button>
  <pre>
    <code class="block" data-minitest-target="output"></code>
  </pre>
</div>
