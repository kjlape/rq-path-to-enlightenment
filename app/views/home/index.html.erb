<div class="bg-white">
  <div class="mx-auto max-w-7xl py-16 px-4 sm:py-24 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-lg font-semibold text-indigo-600">Dashboard</h2>
      <p class="mt-1 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">Your Progress</p>
      <p class="mx-auto mt-5 max-w-xl text-xl text-gray-500">Track your journey to Ruby mastery</p>
    </div>
  </div>
</div>

<div class="bg-white py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mt-10">
      <h3 class="text-lg font-medium leading-6 text-gray-900">Overall Completion: <%= number_to_percentage(Current.user.overall_completion, precision: 0) %></h3>
      <div class="mt-2 h-6 w-full bg-gray-200 rounded-full">
        <div class="h-6 rounded-full bg-indigo-600" style="width: <%= Current.user.overall_completion %>%"></div>
      </div>
    </div>

    <div class="mt-10">
      <h3 class="text-lg font-medium leading-6 text-gray-900">Journeys</h3>
      <dl class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2">
        <% Current.user.journeys.each do |journey| %>
          <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="px-4 py-5 sm:p-6">
              <dt class="text-sm font-medium text-gray-500 truncate"><%= journey.title %></dt>
              <dd class="mt-1 text-3xl font-semibold text-gray-900"><%= number_to_percentage(journey.completion_percentage(Current.user), precision: 0) %></dd>
              <div class="mt-2 w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
                <div class="bg-indigo-600 h-2.5 rounded-full" style="width: <%= journey.completion_percentage(Current.user) %>%"></div>
              </div>
            </div>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
</div>
