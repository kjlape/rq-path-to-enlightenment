<div class="bg-white">
  <div class="mx-auto max-w-7xl py-16 px-4 sm:py-24 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-lg font-semibold text-indigo-600">Settings</h2>
      <p class="mt-1 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">Account Settings</p>
      <p class="mx-auto mt-5 max-w-xl text-xl text-gray-500">Manage your account and security settings</p>
    </div>
  </div>
</div>

<div class="bg-white py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mt-10">
      <h3 class="text-lg font-medium leading-6 text-gray-900">Account Information</h3>
      <div class="mt-5">
        <ul class="divide-y divide-gray-200">
          <li class="py-4 flex justify-between items-center">
            <div>
              <p class="text-sm font-medium text-gray-900">Username</p>
              <p class="text-sm text-gray-500"><%= Current.user.username %></p>
            </div>
          </li>
          <li class="py-4 flex justify-between items-center">
            <div>
              <p class="text-sm font-medium text-gray-900">Email Address</p>
              <p class="text-sm text-gray-500"><%= Current.user.email %></p>
            </div>
          </li>
          <li class="py-4 flex justify-between items-center">
            <div>
              <p class="text-sm font-medium text-gray-900">Account Created</p>
              <p class="text-sm text-gray-500"><%= Current.user.created_at.strftime('%B %d, %Y') %></p>
            </div>
          </li>
          <li class="py-4 flex justify-between items-center">
            <div>
              <p class="text-sm font-medium text-gray-900">Last Login</p>
              <p class="text-sm text-gray-500"><%= Current.user.last_sign_in_at&.strftime('%B %d, %Y') || 'N/A' %></p>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10">
      <h3 class="text-lg font-medium leading-6 text-gray-900">Login and Verification</h3>
      <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <%= link_to "Change password", edit_password_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= link_to "Change email address", edit_identity_email_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= link_to "Two-Factor Authentication", new_two_factor_authentication_profile_totp_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
        <% if Current.user.otp_required_for_sign_in? %>
          <div>
            <%= link_to "Recovery Codes", two_factor_authentication_profile_recovery_codes_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="mt-10">
      <h3 class="text-lg font-medium leading-6 text-gray-900">Access History</h3>
      <div class="mt-5">
        <%= link_to "Devices & Sessions", sessions_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    </div>

    <div class="mt-10">
      <%= button_to "Log out", Current.session, method: :delete, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
    </div>
  </div>
</div>

